{
  "$schema": "../Microsoft.DotNet.RecursiveSigning/docs/signing-config-schema.json",
  "certificates": [
    {
      "friendlyName": "Microsoft400",
      "operations": [
        {
          "KeyCode": "CP-230012",
          "OperationCode": "SigntoolSign",
          "Parameters": {
            "OpusName": "Microsoft",
            "OpusInfo": "http://www.microsoft.com",
            "FileDigest": "/fd \"SHA256\"",
            "PageHash": "/NPH",
            "TimeStamp": "/tr \"http://rfc3161.gtm.corp.microsoft.com/TSS/HttpTspServer\" /td sha256"
          },
          "ToolName": "sign",
          "ToolVersion": "1.0"
        },
        {
          "KeyCode": "CP-230012",
          "OperationCode": "SigntoolVerify",
          "Parameters": {},
          "ToolName": "sign",
          "ToolVersion": "1.0"
        }
      ]
    },
    {
      "friendlyName": "NuGet",
      "$comment": "NuGet package signing. Applied to .nupkg files after their inner binaries are signed.",
      "operations": [
        {
          "KeyCode": "CP-401405",
          "OperationCode": "NuGetSign",
          "Parameters": {},
          "ToolName": "sign",
          "ToolVersion": "1.0"
        },
        {
          "KeyCode": "CP-401405",
          "OperationCode": "NuGetVerify",
          "Parameters": {},
          "ToolName": "sign",
          "ToolVersion": "1.0"
        }
      ]
    },
    {
      "friendlyName": "3rdPartySHA2",
      "$comment": "Same Authenticode certificate but with alwaysSign=true. Used for third-party binaries that arrive pre-signed and need a Microsoft signature added on top.",
      "alwaysSign": true,
      "operations": [
        {
          "KeyCode": "CP-231522",
          "OperationCode": "SigntoolSign",
          "Parameters": {
            "OpusName": "Microsoft",
            "OpusInfo": "http://www.microsoft.com",
            "Append": "/as",
            "FileDigest": "/fd \"SHA256\"",
            "PageHash": "/NPH",
            "TimeStamp": "/tr \"http://rfc3161.gtm.corp.microsoft.com/TSS/HttpTspServer\" /td sha256"
          },
          "ToolName": "sign",
          "ToolVersion": "1.0"
        },
        {
          "KeyCode": "CP-231522",
          "OperationCode": "SigntoolVerify",
          "Parameters": {
            "VerifyAll": "/all"
          },
          "ToolName": "sign",
          "ToolVersion": "1.0"
        }
      ]
    }
  ],
  "rules": {
    "fileExtensionMappings": {
      ".dll": "Microsoft400",
      ".exe": "Microsoft400",
      ".nupkg": "NuGet"
    },
    "fileNameMappings": {
      "Newtonsoft.Json.dll": "3rdPartySHA2",
      "Newtonsoft.Json.Bson.dll": "3rdPartySHA2"
    }
  }
}
